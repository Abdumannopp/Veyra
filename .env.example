PORT=3000
# production is the safe default (no demo users, sign-up closed).
# Use NODE_ENV=development ONLY on your own computer: it creates demo accounts with public passwords.
NODE_ENV=production
# Optional. Development listens on 127.0.0.1 only; production on 0.0.0.0.
HOST=
DATABASE_PATH=./data/veyra.db
# PostgreSQL (recommended in production). When set, it is used instead of the SQLite file above.
# On Railway: add a PostgreSQL service and set DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
JWT_SECRET=

# Name of the first company (tenant 1): shown in the app, on invoices and on the customer tracking page.
# Read on the first start only. More companies are added in the app (Companies panel).
COMPANY_NAME=

# Region settings
# kg or lb
WEIGHT_UNIT=kg
# ISO currency code shown on prices, e.g. USD, EUR, UZS, KZT
CURRENCY=USD
# Largest allowed price. Raise it for currencies with big numbers (e.g. UZS: 10000000000).
MAX_RATE=10000000

# ---------- AI agents ----------
# ONE AI provider for FLOW and VAULT: openrouter, openai, anthropic or google.
# Empty = the first provider below that has a key (OpenRouter first). No key = AI is off, nothing leaves the server.
AI_PROVIDER=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model id from openrouter.ai/models: set it to the model you tested. Empty = your account's default model (can change; the server warns).
OPENROUTER_MODEL=
# OpenAI (https://platform.openai.com): key and model, both required.
OPENAI_API_KEY=
OPENAI_MODEL=
# Anthropic (https://console.anthropic.com): key and model, both required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Google Gemini (https://aistudio.google.com): key and model, both required.
GEMINI_API_KEY=
GEMINI_MODEL=
# AI requests per person per hour (cost control; counted in the database)
AI_RATE_LIMIT_PER_HOUR=60

# AI requests per company per UTC day, screens and automatic work together (counted in the database).
AI_DAILY_LIMIT_PER_TENANT=300
# Seconds the AI may take to answer, in milliseconds.
AI_TIMEOUT_MS=20000

# ---------- Encryption of stored secrets ----------
# Each company's own Twilio token is stored encrypted with this key. Use a long random value and keep it
# safe. If empty, JWT_SECRET is used. If the key ever changes, saved Twilio settings must be entered again.
SECRETS_KEY=

# ---------- SMS / WhatsApp (RELAY) ----------
# Each company connects its OWN Twilio account in the app (Integrations -> Connect Twilio).
# The settings below are the platform owner's account: used by the first company only,
# unless MESSAGING_SHARED_ALL_TENANTS=true (then every company sends through it).
# Empty = messages are drafted and can be copied, but not sent automatically.
MESSAGING_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender numbers in international format, e.g. +15551234567 (leave one empty to switch that channel off)
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
MESSAGING_SHARED_ALL_TENANTS=
MESSAGE_RATE_LIMIT_PER_HOUR=60
# Delivery reports from Twilio, per minute.
TWILIO_STATUS_RATE_LIMIT_PER_MINUTE=1200
# Public https address of this server, e.g. https://veyra.example.com. Twilio sends "delivered / read / failed"
# reports to it. Render and Railway set it automatically; empty elsewhere = no delivery reports.
PUBLIC_URL=

# ---------- Order mailbox (IMAP) and map ----------
# Each company connects its mailbox in the app. Polling interval in minutes.
IMAP_POLL_MINUTES=5
# Allow mail servers in a private network (default: refused)
IMAP_ALLOW_PRIVATE=
# osm = road distance and off-route warnings (sends load place names to OpenStreetMap services). Empty = off.
GEO_PROVIDER=
NOMINATIM_URL=
OSRM_URL=
# A truck farther than this many km from the road is flagged
OFF_ROUTE_KM=60
# Live traffic for trucks on the road (needs GEO_PROVIDER=osm): tomtom + a TomTom API key. Empty = off.
TRAFFIC_PROVIDER=
TOMTOM_API_KEY=
# Only change for a TomTom-compatible proxy.
# TOMTOM_URL=https://api.tomtom.com

# ---------- Gmail / Outlook sign-in (needs PUBLIC_URL) ----------
# Redirect address to register with both providers: <PUBLIC_URL>/api/integrations/mail-oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ---------- NEXUS, email inbox and documents ----------
# NEXUS prepares tasks (orders by email, carrier suggestions, drafted messages, quiet trucks).
# It never sends, books or changes anything by itself. false switches it off.
NEXUS_ENABLED=true
# Orders by email: each company creates its inbox address in the app (Integrations -> Email inbox).
INBOX_DAILY_LIMIT=200
INBOX_RATE_LIMIT_PER_MINUTE=60
# All companies together, per sending IP address.
INBOX_IP_RATE_LIMIT_PER_MINUTE=600
# Emails with files: largest whole email (MB) and how many files are kept per email.
INBOX_MAX_MB=15
INBOX_MAX_ATTACHMENTS=5
# Documents (CMR, proof of delivery). Files are stored in the database; set a backup.
DOC_MAX_MB=8
DOC_MAX_PER_SHIPMENT=20
DOC_RATE_LIMIT_PER_HOUR=60

# ---------- GPS ----------
# Each company creates its own GPS token in the app (Integrations → Create GPS token).
# Positions closer together than this are not stored again.
GPS_MIN_INTERVAL_MINUTES=15
GPS_RATE_LIMIT_PER_MINUTE=600
# A booked truck with no location update for this long is flagged.
STALE_TRACKING_HOURS=12

# Sign-up. In production nobody can self-register unless one of these is set;
# the administrator adds people from the dashboard (Team Access → Add user).
# REGISTRATION_INVITE_CODE: people may sign up with this code (they become operators).
REGISTRATION_INVITE_CODE=
# ALLOW_OPEN_REGISTRATION=true: anyone may sign up (not recommended for real customer data).
ALLOW_OPEN_REGISTRATION=

# ---------- Backups ----------
# A full copy of the database every day. Empty BACKUP_DIR = a "backups" folder next to the database.
BACKUP_ENABLED=true
BACKUP_DIR=
BACKUP_KEEP=7

# First administrator, created on the first production start (password 12+ characters).
# Email address the pricing page's "Start free trial" and "Contact sales" buttons write to.
SALES_EMAIL=
# Card payments with Paddle Billing (optional). All off until the client token, webhook secret and prices are set.
# sandbox for testing, production for real money.
PADDLE_ENV=sandbox
# Paddle > Developer tools > Authentication: client-side token (safe in the browser).
PADDLE_CLIENT_TOKEN=
# Paddle > Developer tools > Notifications: the secret of the destination https://<your-domain>/api/integrations/paddle/webhook
PADDLE_WEBHOOK_SECRET=
# Server API key (switch plans, open the billing portal). Optional; keep it secret.
PADDLE_API_KEY=
# Price ids (pri_...) from Paddle > Catalog. Leave a period empty if you do not sell it.
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_YEARLY=
PADDLE_PRICE_GROWTH_MONTHLY=
PADDLE_PRICE_GROWTH_YEARLY=
PADDLE_PRICE_SCALE_MONTHLY=
PADDLE_PRICE_SCALE_YEARLY=
# New companies sign themselves up at /signup (choose a plan, then pay by card). On by default when Paddle is set up; true / false to override.
COMPANY_SIGNUP=
# Shown on /terms, /privacy and /refunds. Have the texts reviewed by a lawyer before selling.
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_COUNTRY=
LEGAL_EMAIL=
# Days after the first payment in which a full refund is offered (0 = no refunds except where the law requires).
REFUND_DAYS=14
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
ALLOWED_ORIGIN=

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Failed logins per account from one address
LOGIN_RATE_LIMIT_MAX=8
# Failed logins per address (all accounts)
LOGIN_RATE_LIMIT_IP_MAX=30
# Failed logins per account from all addresses together
LOGIN_RATE_LIMIT_ACCOUNT_MAX=30
LOGIN_FAILURE_LOG_THRESHOLD=4
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5
# Password hashing cost (10-14). Higher is slower and stronger.
BCRYPT_COST=12

# Document files: "database" (default) or "r2" (Cloudflare R2). See DEPLOYMENT.md.
DOCUMENT_STORAGE=database
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 32 random bytes (base64). Encrypts every new document. Keep a safe copy; never change it.
DOCUMENT_ENCRYPTION_KEY=
